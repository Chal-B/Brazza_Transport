---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.tsx';
import { getToutesLesLignes } from '../lib/lignes';
import { tousLesArrets } from '../lib/search-engine';

const lignes = getToutesLesLignes();
const arrets = tousLesArrets(lignes);
const nbLignes = lignes.length;
const toutesVerifiees = lignes.every((ligne) => ligne.statut_verification === 'verifie');
const compteur = toutesVerifiees
  ? `${nbLignes} lignes documentées et vérifiées sur le corridor prioritaire`
  : `${nbLignes} lignes documentées sur le corridor prioritaire`;
---

<BaseLayout
  titre="Brazza Transport — Où voulez-vous aller ?"
  description={`Itinéraires et tarifs des transports en commun de Brazzaville sur ${nbLignes} lignes relevées sur le terrain.`}
  navActif="accueil"
>
  <p class="marque">Brazza<span>Transport</span></p>

  <svg class="fond-decoratif" viewBox="0 0 1280 460" preserveAspectRatio="none" aria-hidden="true">
    <path d="M -20 90 C 120 40, 200 150, 320 110 S 420 40, 340 170"></path>
    <path d="M 1300 60 C 1160 20, 1080 140, 960 95 S 860 30, 940 165"></path>
    <path d="M -20 360 C 100 320, 180 420, 300 380 S 360 300, 260 260"></path>
    <path d="M 1300 400 C 1180 360, 1100 440, 990 400 S 930 320, 1020 290"></path>
    <circle cx="320" cy="110" r="4.5"></circle>
    <circle cx="960" cy="95" r="4.5"></circle>
    <circle cx="300" cy="380" r="4"></circle>
    <circle cx="990" cy="400" r="4"></circle>
  </svg>

  <h1 class="titre-hero">Où voulez-vous aller&nbsp;?</h1>

  <SearchBar client:load arrets={arrets} />

  <div class="liens-rapides">
    <a href="/lignes" class="bouton-contour">Toutes les lignes</a>
    <a href="/tarifs" class="bouton-contour">Tarifs de référence</a>
  </div>

  <p class="compteur-lignes">{compteur}</p>

  <p class="pied-signaler">
    <a href="/signalement">Vous connaissez une ligne ? Signalez-la</a>
  </p>
</BaseLayout>
