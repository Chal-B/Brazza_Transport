---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FareBadge from '../../components/FareBadge.tsx';
import { getConfigGlobale, getToutesLesLignes } from '../../lib/lignes';
import { badgeFraicheurDeLigne } from '../../lib/freshness-badge';
import { lignesDesservantArret } from '../../lib/search-engine';
import type { Creneau, Ligne } from '../../lib/types';

export function getStaticPaths() {
  return getToutesLesLignes().map((ligne) => ({
    params: { id: ligne.id },
    props: { ligne },
  }));
}

interface Props {
  ligne: Ligne;
}

const { ligne } = Astro.props;
const config = getConfigGlobale();
const toutesLesLignes = getToutesLesLignes();
const badge = badgeFraicheurDeLigne(ligne);

const arrets = ligne.arrets_principaux.map((arret) => ({
  nom: arret.nom,
  repere: arret.repere,
  correspondances: lignesDesservantArret(arret.nom, toutesLesLignes)
    .filter((autre) => autre.id !== ligne.id)
    .map((autre) => autre.id),
}));

const tarifNormal = ligne.tarification.normal.jour_fcfa;
const heurePointe = ligne.tarification.heure_pointe;
const criseCarburant = ligne.tarification.crise_carburant;
const afficherHeurePointe = heurePointe !== undefined && heurePointe.fcfa !== tarifNormal;

const formaterCreneau = (creneau: Creneau) =>
  `${creneau.debut.replace(':', 'h')}–${creneau.fin.replace(':', 'h')}`;
const creneaux = (heurePointe?.creneaux ?? []).map(formaterCreneau).join(' et ');

const particularites = ligne.particularites ?? [];
const lienSignalement = `/signalement?ligne=${encodeURIComponent(ligne.id)}`;
---

<BaseLayout
  titre={`${ligne.id} — ${ligne.nom} | Brazza Transport`}
  description={`Arrêts, tarifs et fraîcheur des données de la ligne ${ligne.id} : ${ligne.depart} vers ${ligne.arrivee}.`}
>
  <main class="ecran-app">
    <div class="colonne-app">
      <div class="entete-fiche">
        <a href="/lignes" class="retour" aria-label="Retour à la liste des lignes">&larr;</a>
        <div>
          <p class="titre-bloc">Ligne {ligne.id}</p>
          <h1 class="titre-fiche">{ligne.nom}</h1>
        </div>
      </div>

      <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class="pilule-mode">Bus standard</span>
        <span class={`badge ${badge.classe}`}>{badge.libelle}</span>
      </div>

      <section class="mt-7">
        <h2 class="titre-bloc">Trajet complet</h2>
        <ol class="timeline mt-3">
          {
            arrets.map((arret) => (
              <li class="arret">
                <div class="nom-arret">{arret.nom}</div>
                {arret.repere && <div class="repere-arret">{arret.repere}</div>}
                {arret.correspondances.length > 0 && (
                  <span class="correspondance-arret">
                    ↔ {arret.correspondances.join(' · ')}
                  </span>
                )}
              </li>
            ))
          }
        </ol>
      </section>

      <section class="mt-7">
        <h2 class="titre-bloc">Tarifs</h2>
        <div class="carte mt-3">
          <div class="bloc-tarif">
            <div class="tarif-label">Tarif normal</div>
            <span class="badge badge-frais">{tarifNormal} FCFA</span>
          </div>

          {
            afficherHeurePointe && heurePointe && (
              <div class="bloc-tarif">
                <div>
                  <div class="tarif-label">Heure de pointe</div>
                  {creneaux && <div class="tarif-note">{creneaux}</div>}
                  {heurePointe.note && <div class="tarif-note">{heurePointe.note}</div>}
                </div>
                <span class="badge badge-pointe">{heurePointe.fcfa} FCFA</span>
              </div>
            )
          }

          {
            criseCarburant && (
              <div class="bloc-tarif">
                <div>
                  <div class="tarif-label">Crise carburant</div>
                  <div class="tarif-note">Appliqué quand l'alerte carburant est active</div>
                </div>
                <span class="badge badge-alerte">{criseCarburant.fcfa} FCFA</span>
              </div>
            )
          }

          <FareBadge client:load ligne={ligne} config={config} />
        </div>
      </section>

      {
        particularites.length > 0 && (
          <section class="mt-7">
            <h2 class="titre-bloc">Particularités</h2>
            <ul class="mt-3 grid gap-2 pl-5">
              {particularites.map((particularite) => (
                <li class="sous-texte">{particularite}</li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="mt-9 mb-8 grid">
        <a href={lienSignalement} class="cta">Signaler une erreur sur cette ligne</a>
      </div>
    </div>
  </main>
</BaseLayout>
