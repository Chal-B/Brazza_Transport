---
const reseaux = [
  { nom: 'Instagram', href: 'https://instagram.com/brazzatransport' },
  { nom: 'TikTok', href: 'https://tiktok.com/@brazzatransport' },
  { nom: 'Facebook', href: 'https://facebook.com/brazzatransport' },
] as const;
---

<footer class="footer-app">
  <p class="footer-equipe">
    Une initiative de Divin Le Millenaire ENZAMOY &amp; Malonga Saint Chalbhery
  </p>

  <ul class="footer-reseaux">
    {
      reseaux.map((reseau) => (
        <li>
          <a href={reseau.href} aria-label={reseau.nom} rel="noopener noreferrer" target="_blank">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              {reseau.nom === 'Instagram' && (
                <>
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none"></circle>
                </>
              )}
              {reseau.nom === 'TikTok' && (
                <>
                  <path d="M13.5 4v10.8a3.2 3.2 0 1 1-2.6-3.15"></path>
                  <path d="M13.5 4c.35 2.1 1.9 3.7 4.1 4.05"></path>
                </>
              )}
              {reseau.nom === 'Facebook' && (
                <>
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <path d="M14 8.5h-1.3a1.7 1.7 0 0 0-1.7 1.7V11h3l-.4 2.2h-2.6V19"></path>
                </>
              )}
            </svg>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="footer-email">
    <a href="mailto:contact@brazzatransport.cg">contact@brazzatransport.cg</a>
  </p>

  <p class="footer-legal">
    Brazza Transport est une initiative indépendante, non affiliée aux sociétés de transport ni aux
    autorités municipales. Informations collectées sur le terrain, mises à jour par la communauté.
  </p>
</footer>
