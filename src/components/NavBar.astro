---
interface Props {
  actif?: 'accueil' | 'chercher' | 'lignes' | 'tarifs' | 'signaler';
}

const { actif } = Astro.props;

const liens = [
  { cle: 'accueil', href: '/', libelle: 'Accueil' },
  { cle: 'chercher', href: '/recherche', libelle: 'Chercher' },
  { cle: 'lignes', href: '/lignes', libelle: 'Lignes' },
  { cle: 'tarifs', href: '/tarifs', libelle: 'Tarifs' },
  { cle: 'signaler', href: '/signalement', libelle: 'Signaler' },
] as const;
---

<nav class="barre-nav" aria-label="Navigation principale">
  <a href="/" class="marque-nav">Brazza<span>Transport</span></a>
  <ul class="liens-nav">
    {
      liens.map((lien) => (
        <li>
          <a
            href={lien.href}
            class="item-nav"
            data-actif={actif === lien.cle ? 'oui' : undefined}
            aria-current={actif === lien.cle ? 'page' : undefined}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              {lien.cle === 'accueil' && (
                <>
                  <path d="M4 11.5 12 4l8 7.5"></path>
                  <path d="M6 10v9a1 1 0 0 0 1 1h3v-6h4v6h3a1 1 0 0 0 1-1v-9"></path>
                </>
              )}
              {lien.cle === 'chercher' && (
                <>
                  <circle cx="11" cy="11" r="6.5"></circle>
                  <path d="M20 20l-4.5-4.5"></path>
                </>
              )}
              {lien.cle === 'lignes' && <path d="M4 6h16M4 12h16M4 18h10"></path>}
              {lien.cle === 'tarifs' && (
                <>
                  <path d="M12 3h6a2 2 0 0 1 2 2v6l-9 9-8-8 9-9Z"></path>
                  <circle cx="15.5" cy="8.5" r="1.3" fill="currentColor" stroke="none"></circle>
                </>
              )}
              {lien.cle === 'signaler' && (
                <>
                  <circle cx="12" cy="12" r="8.5"></circle>
                  <path d="M12 8v5"></path>
                  <circle cx="12" cy="16.3" r="0.9" fill="currentColor" stroke="none"></circle>
                </>
              )}
            </svg>
            {lien.libelle}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
