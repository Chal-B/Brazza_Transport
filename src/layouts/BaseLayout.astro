---
import '../styles/global.css';
import AlertBanner from '../components/AlertBanner.astro';
import NavBar from '../components/NavBar.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  titre: string;
  description?: string;
  navActif?: 'accueil' | 'chercher' | 'lignes' | 'tarifs' | 'signaler';
}

const { titre, description, navActif } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{titre}</title>
    {description && <meta name="description" content={description} />}
    <slot name="head" />
  </head>
  <body class="page-app">
    <a href="#contenu" class="lien-evitement">Aller au contenu</a>
    <NavBar actif={navActif} />
    <AlertBanner />
    <main id="contenu" class="ecran-app">
      <div class="colonne-app">
        <slot />
        <SiteFooter />
      </div>
    </main>
  </body>
</html>
